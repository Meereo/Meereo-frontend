{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx", "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
